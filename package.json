{
  "name": "despolarizamed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "payload": "dotenv -e .env.local -- payload",
    "payload:migrate:create": "cross-env PAYLOAD_DISABLE_PUSH=true dotenv -e .env.local -- node --require ./scripts/next-env-shim.cjs --import tsx scripts/gen-migration.mjs",
    "payload:migrate": "cross-env PAYLOAD_DISABLE_PUSH=true dotenv -e .env.local -- node --require ./scripts/next-env-shim.cjs --import tsx scripts/run-migrate.mjs",
    "payload:generate-types": "cross-env PAYLOAD_DISABLE_PUSH=true dotenv -e .env.local -- node --require ./scripts/next-env-shim.cjs --import tsx scripts/gen-payload-types.mjs",
    "seed:biologia": "node scripts/seed-biologia.mjs",
    "ingest:inventory": "python scripts/pdf-ingest/01_inventory.py",
    "ingest:text": "python scripts/pdf-ingest/02_extract_text.py",
    "ingest:ocr": "python scripts/pdf-ingest/03_ocr.py",
    "ingest:dataset": "python scripts/pdf-ingest/04_build_dataset.py",
    "ingest:load": "dotenv -e .env.local -- node scripts/pdf-ingest/05_load_postgres.mjs",
    "ingest:validate": "python scripts/pdf-ingest/06_validate.py",
    "ingest:questions": "python scripts/pdf-ingest/07_parse_questions.py",
    "ingest:gabaritos": "python scripts/pdf-ingest/08_parse_gabaritos.py",
    "ingest:link": "python scripts/pdf-ingest/09_link_answers.py",
    "ingest:load-questions": "dotenv -e .env.local -- node scripts/pdf-ingest/10_load_questions.mjs",
    "ingest:figures": "python scripts/pdf-ingest/11_extract_figures.py",
    "ingest:dedup": "python scripts/pdf-ingest/12_dedup.py",
    "ingest:gold": "python scripts/pdf-ingest/13_gold_set.py",
    "ingest:load-figures": "dotenv -e .env.local -- node scripts/pdf-ingest/14_load_figures.mjs",
    "ingest:disciplina": "python scripts/pdf-ingest/15_classify_subject.py",
    "ingest:discursivas": "python scripts/pdf-ingest/16_parse_discursivas.py",
    "lista": "python scripts/pdf-ingest/17_gerar_lista.py",
    "ingest:all": "pnpm ingest:inventory && pnpm ingest:text && pnpm ingest:ocr && pnpm ingest:dataset && pnpm ingest:load"
  },
  "dependencies": {
    "@aarkue/tiptap-math-extension": "^1.4.0",
    "@base-ui/react": "^1.7.0",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vidstack/react": "^0.6.15",
    "better-auth": "^1.6.26",
    "bullmq": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.22",
    "payload": "^3.87.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vidstack": "^0.6.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/env": "^15.5.22",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "hls.js": "^1.6.17",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.11.0"
}
